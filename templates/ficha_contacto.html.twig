<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ficha de contacto</title>
</head>
<body>
<h1>Ficha del contacto</h1>
<ul>
    <li><strong>Nombre:</strong> {{ contacto.nombre }}</li>
    <li><strong>Teléfono:</strong> {{ contacto.telefono }}</li>
    <li><strong>Correo:</strong> {{ contacto.email }}</li>
    {% if contacto.provincia %}
        <li><strong>Provincia:</strong> {{ contacto.provincia.nombre }}</li>
    {% endif %}
</ul>
</body>
</html>
