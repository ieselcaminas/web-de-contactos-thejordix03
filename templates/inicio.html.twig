{% extends 'base.html.twig' %}

{% block title %}Inicio{% endblock %}

{% block body %}
<h1>Contactos</h1>
{% if app.user %}
    <h2>Bienvenido a la web de contactos, {{ app.user.name }}.</h2>
{% else %}
    <h2>Bienvenido a la web de contactos. Inicia sesión para continuar.</h2>
{% endif %}
<p>Página de inicio</p>

<a href="{{ path('contacto_nuevo') }}" class="btn btn-primary">Añadir contacto</a>

<ul>
  <ul>
{% for contacto in contactos %}
    <li>
        <a href="{{ path('ficha_contacto', {codigo: contacto.id}) }}">
            {{ contacto.nombre }}
        </a>
        | <a href="{{ path('editar', {codigo: contacto.id}) }}">Editar</a>
        | <a href="{{ path('eliminar_contacto', {id: contacto.id}) }}"
             onclick="return confirm('¿Seguro que quieres eliminar este contacto?');">Borrar</a>
    </li>
{% else %}
    <li>No hay contactos.</li>
{% endfor %}

</ul>
{% endblock %}
